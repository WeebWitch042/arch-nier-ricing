#!/bin/bash

export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export DBUS_SESSION_BUSADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"


BATTERY_PATH="/sys/class/power_supply/BAT0"

if [ ! -d "$BATTERY_PATH" ]; then
    exit 0
fi

capacity=$(cat "$BATTERY_PATH/capacity")
status=$(cat "$BATTERY_PATH/status")

# Battery critically low
if [ "$capacity" -lt 20 ] && [ "$status" = "Discharging" ]; then
    notify-send \
        -u critical \
        "🔋 Low battery!" \
        "Battery is at ${capacity}%. Plug in your charger!"
fi

# Battery full while charging
if [ "$capacity" -ge 95 ] && [ "$status" = "Charging" ]; then
    notify-send \
        -u critical \
        "🔋 Unplug your charger!" \
        "Battery is at ${capacity}%. Unplug the charger."
fi
